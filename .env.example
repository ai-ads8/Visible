# Visible — environment variables. Set these in Vercel (Project → Settings → Environment Variables).
# Visible has its OWN values for everything below. Never reuse Ai Ads' database or secrets.

# ---- Required (the app does not start without them) ----
# Make one with:  openssl rand -base64 48
SESSION_SECRET=

# Storage: a NEW Upstash Redis database used only by Visible (required on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=https://visible-xxxx.vercel.app

# Who can open /admin (comma separated).
ADMIN_EMAILS=

# ---- AI checks (off until you switch them on) ----
# Both are needed for real, paid AI checks. Without VISIBLE_LIVE_MEASUREMENTS=on no paid call is ever made.
# OPENAI_API_KEY=
# VISIBLE_LIVE_MEASUREMENTS=on
# OPENAI_MEASURE_MODEL=gpt-6-luna
# DAILY_BUDGET_USD=3            # hard daily spend cap for the whole app
# DAILY_QUESTION_LIMIT=150      # hard daily question cap for the whole app
# FREE_ROUNDS_PER_IP=2          # free AI checks per visitor per day
# FREE_ROUNDS_PER_DAY=40        # free AI checks per day in total
# ANSWER_CACHE_DAYS=7           # same question + place reuses the answer (no cost)

# Test mode on a deployed site: sample answers, clearly labelled, never counted. Leave off in production.
# VISIBLE_DEMO=on

# ---- Payments (Stripe, Visible's own account) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_PRO=

# ---- Scheduled checks for paid plans (Vercel Cron) ----
# CRON_SECRET=

# Only for local testing, never in production (ignored when NODE_ENV=production):
# ALLOW_PRIVATE_SCAN=1
